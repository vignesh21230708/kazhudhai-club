# ── KAZHUDHAI CLUB Environment Variables Template ──
# Copy to .env for local overrides, or configure these in your cloud host dashboard

# Hosting platform assigned port (dynamically injected by Render, Railway, Heroku, etc.)
PORT=5000

# Debug Mode: set to 'false' in production; 'true' for local debugging only
DEBUG=false

# Secret Key: generate a strong random 32-character hex token for production
# If omitted, KAZHUDHAI CLUB generates a cryptographically secure random key per instance
# SECRET_KEY=replace_with_secure_random_hex_token

# Socket.IO Async Worker Mode ('eventlet' in production Linux, 'threading' on Windows dev)
SOCKETIO_ASYNC_MODE=eventlet

# Optional: PostgreSQL Database connection string
# DATABASE_URL=postgresql://user:password@host:port/dbname
